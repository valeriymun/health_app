# Database
DATABASE_URL=sqlite:///./health_data.db

# Oura Ring
OURA_PERSONAL_ACCESS_TOKEN=your_oura_token_here

# Garmin Connect
# Either set email/password OR pre-populate ~/.garminconnect with cached
# garth tokens (oauth1_token.json + oauth2_token.json). Token cache wins.
GARMIN_EMAIL=your_garmin_email
GARMIN_PASSWORD=your_garmin_password
# Optional: override the token-store location
# GARMIN_TOKEN_STORE=~/.garminconnect

# Hevy (requires Hevy Pro subscription for API access)
# Get a key at https://hevy.com/settings?developer
HEVY_API_KEY=your_hevy_api_key

# Apple Health Shortcuts
APPLE_HEALTH_API_KEY=generate_a_random_key_here

# Server
HOST=0.0.0.0
PORT=8000
