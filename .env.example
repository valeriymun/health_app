# Database (existing FastAPI backend)
DATABASE_URL=sqlite:///./health_data.db

# Oura Ring OAuth2
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret

# Garmin Connect
GARMIN_EMAIL=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password

# Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id

# Flask sync app (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# Server (existing FastAPI backend)
HOST=0.0.0.0
PORT=8000
